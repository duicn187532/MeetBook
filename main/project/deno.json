{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-sys server.ts",
    "check": "deno check server.ts booking_rules_test.ts logger_test.ts conflict_integration_test.ts scripts/migrate_string_times.ts scripts/migrate_string_times_test.ts",
    "test": "deno test --allow-env --ignore=conflict_integration_test.ts",
    "test:integration": "deno test --allow-env --allow-net --allow-read --allow-sys conflict_integration_test.ts",
    "migrate:times": "deno run --allow-net --allow-read --allow-env --allow-sys --allow-write=. scripts/migrate_string_times.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.11",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "cors": "https://deno.land/x/cors@v1.2.2/mod.ts",
    "mongodb": "npm:mongodb@5.6.0",
    "oak": "https://deno.land/x/oak@v17.1.4/mod.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.ns"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "include": [
      "*.ts",
      "scripts/"
    ]
  },
  "lint": {
    "include": [
      "*.ts",
      "scripts/"
    ]
  }
}
