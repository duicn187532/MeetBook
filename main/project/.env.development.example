# 複製成 .env.development 後填入本地開發用的值（.env.development 不會進 git）
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=MeetingBooking_development
# 選填：debug | info | warning | error，預設 info
LOG_LEVEL=debug
# 選填：LINE 官方帳號（Messaging API），未設定時 /line/webhook 回 503
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 選填：管理後台 /admin 的登入密碼（至少 8 個字元）；未設定時 /admin 回 404
ADMIN_PASSWORD=
# 選填：遷移切換期間設為 true，舊系統只能查詢不能寫入
READ_ONLY=
# 選填：預約網站的來源（正式環境的 CORS），例如 https://<帳號>.github.io
FRONTEND_ORIGIN=
# 選填：萬用編輯密碼（至少 8 個字元），未設定時不啟用
MASTER_PASSWORD=
