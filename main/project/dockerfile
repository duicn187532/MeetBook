# 使用官方 Deno 映像
FROM denoland/deno:2.2.4

# 設置工作目錄
WORKDIR /app

# 複製所有應用程式檔案到容器中
COPY . .

# 預先編譯以提高啟動效能（選用）
# RUN deno cache server.ts

# 设置环境变量（不要设置 PORT，让 Cloud Run 自动设置）
ENV ENV=production
ENV MONGODB_URI=mongodb+srv://root:***REMOVED***@mycluster.wk4zgas.mongodb.net/MeetingBooking?retryWrites=true&w=majority&authSource=admin
ENV DB_NAME=MeetingBooking_production
ENV LOGFLARE_SOURCE_TOKEN=***REMOVED***
ENV LOGFLARE_API_KEY=***REMOVED***

# Cloud Run 會動態分配端口
EXPOSE 8080

# 設定啟動命令
CMD ["deno", "run", "--allow-net", "--allow-read", "--allow-env", "--allow-sys", "server.ts"]