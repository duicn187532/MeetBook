// Cloudflare Pages 入口：公司網路擋 *.workers.dev，但可以連 *.pages.dev
// 這個 Pages 專案只負責把請求原封不動轉給 Worker（service binding），程式與資料都只有 Worker 一份。
// 專案名稱與 Worker 名稱是佔位字（repo 為公開）：部署時由 .github/workflows/deploy-worker.yml 以 GitHub Secrets 填入
{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "__PAGES_PROJECT__",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-11-01",
  "services": [{ "binding": "API", "service": "__WORKER_NAME__" }]
}
